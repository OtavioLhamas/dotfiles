$ErrorActionPreference = "Stop"

if ($env:DOTFILES_TEST -eq "1" -and $env:DOTFILES_TEST_SKIP_WSL -eq "1") {
    Write-Host "Skipping WSL setup for the native Windows test lane."
    exit 0
}

$Distro = "Ubuntu"
$User = $env:UserName

if (!(Get-Command "wsl" -ErrorAction SilentlyContinue)) {
    Write-Error "WSL command not found. Ensure your DSC run completed successfully or reboot."
    exit 1
}

# Inbox wsl.exe (System32) exists even when the WSL SUBSYSTEM is not installed.
# Probe with an exit-code check and fail with an actionable message instead.
wsl --status *> $null
if ($LASTEXITCODE -ne 0) {
    Write-Error "WSL subsystem is not installed (wsl --status exited $LASTEXITCODE). Install it with 'wsl --install --no-distribution' (or enable Microsoft-Windows-Subsystem-Linux + VirtualMachinePlatform and install the Microsoft.WSL MSI — the Store/MSIX path fails from SSH with 0x80073d19), then reboot."
    exit 1
}

$WslList = wsl --list --quiet
if ($WslList -notcontains $Distro) {
    Write-Host "Installing fresh $Distro instance..." -ForegroundColor Yellow
    # wsl --install -d $Distro --no-launch

    # Give the subsystem a moment to initialize the storage layer
    Start-Sleep -Seconds 5
}

Write-Host "Provisioning user '$User' inside guest..." -ForegroundColor Yellow
wsl -d $Distro -u root bash -c "
    if ! id -u $User >/dev/null 2>&1; then
        useradd -m -s /bin/bash -G sudo $User
    else
        echo 'User account already exists.'
    fi
"

# Inject the wsl.conf configuration file to set the default engine states
Write-Host "-> Writing /etc/wsl.conf configuration states..." -ForegroundColor Yellow
$WslConfContent = @"
[boot]
systemd=true

[user]
default=$User

[automount]
options = "metadata,uid=1000,gid=1000,umask=22,fmask=11"
"@

# Pass the raw string block over the stdin pipeline directly into a root file inside the guest
$WslConfContent | wsl -d $Distro -u root bash -c "cat > /etc/wsl.conf"

# Cycle the VM instance to forcefully apply the new wsl.conf settings
Write-Host "-> Terminating WSL to reload configuration states..." -ForegroundColor Yellow
wsl --terminate $Distro
Start-Sleep -Seconds 3

# KICK OFF THE RECURSIVE LOOP
# The VM boots up natively as the current user and hands execution to the
# repo's own bootstrap.sh, taken from the local checkout (no network fetch).
Write-Host "-> Triggering downstream Linux Bootstrap inside Guest VM..." -ForegroundColor Green
{{ if .chezmoi.workingTree -}}
$Bootstrap = Join-Path "{{ .chezmoi.workingTree }}" "bootstrap.sh"
$BootstrapWsl = (wsl -d $Distro wslpath -a "$Bootstrap")
wsl -d $Distro -u $User bash -lc "bash '$BootstrapWsl'"
{{ else -}}
$BootstrapUrl = if ($env:DOTFILES_BOOTSTRAP_URL) { $env:DOTFILES_BOOTSTRAP_URL } else { "https://raw.githubusercontent.com/OtavioLhamas/dotfiles/main/bootstrap.sh" }
wsl -d $Distro -u $User bash -lc "curl -fsSL '$BootstrapUrl' | bash"
{{ end -}}

Write-Host "====== WSL Provisioning Completed Succesfully ======" -ForegroundColor Cyan
