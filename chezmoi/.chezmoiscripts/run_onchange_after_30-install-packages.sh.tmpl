#!/bin/bash
# Installs packages from .chezmoidata/packages.yaml via scripts
# Only for packages not handled by mise or ansible

set -euo pipefail

DISTRO="{{ .chezmoi.osRelease.id }}"

wanted_packages=()
{{- $machine := dict "categories" $.categories "distro" .chezmoi.osRelease.id "form_factor" $.form_factor "desktop_environment" $.desktop_environment }}
{{- range $pkg := .packages.linux }}
{{-   if eq (includeTemplate ".chezmoitemplates/pkg-gate.txt" (dict "entry" $pkg "machine" $machine)) "1" }}
wanted_packages+=("{{ $pkg.name }}")
{{-   end }}
{{- end }}

if [[ ${#wanted_packages[@]} -eq 0 ]]; then
    echo "No script-managed packages defined."
    exit 0
fi

missing_packages=()
case "$DISTRO" in
    arch|cachyos)
        for pkg in "${wanted_packages[@]}"; do
            if ! pacman -Q "$pkg" &>/dev/null; then
                missing_packages+=("$pkg")
            fi
        done
        ;;
    pop|ubuntu|debian)
        for pkg in "${wanted_packages[@]}"; do
            if ! dpkg -l "$pkg" 2>/dev/null | grep -q '^ii'; then
                missing_packages+=("$pkg")
            fi
        done
        ;;
    fedora)
        for pkg in "${wanted_packages[@]}"; do
            if ! rpm -q "$pkg" &>/dev/null; then
                missing_packages+=("$pkg")
            fi
        done
        ;;
    *)
        echo "Unknown/unsupported distro '$DISTRO'. Cannot check packages."
        exit 1
        ;;
esac

if [[ ${#missing_packages[@]} -eq 0 ]]; then
    echo "All script-managed packages already installed."
    exit 0
fi

echo "Installing missing packages: ${missing_packages[*]}"
case "$DISTRO" in
    pop|ubuntu|debian)
        sudo apt-get update -qq
        sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
        ;;
    fedora)
        sudo dnf install -y "${missing_packages[@]}"
        ;;
    arch|cachyos)
        # Arch-family systems require a full sync/upgrade transaction; never use -Sy alone.
        if [[ "${DOTFILES_TEST:-}" == "1" ]]; then
            sudo pacman -Syu --needed --noconfirm "${missing_packages[@]}"
        else
            sudo pacman -Syu --needed "${missing_packages[@]}"
        fi
        ;;
    *)
        echo "Unknown/unsupported distro '$DISTRO'. Cannot install packages." >&2
        exit 1
        ;;
esac
