# Mise configuration — user-space development tools
# Tools are installed by `run_after_20-provision.sh` via `mise install`
# See: https://mise.jdx.dev/registry.html

[tools]
### Common tools (all platforms) ###
"core:python" = "3.13"
"core:rust" = "1.95"
"core:node" = "26"
"core:java" = "latest"
"vfox:mise-plugins/vfox-lua" = { version = "5.1", os = ["linux"] } # Windows installs via winget

"aqua:neovim/neovim" = "0.12.5"
"aqua:LuaLS/lua-language-server" = "latest"
# "aqua:restic/restic" = "latest"
"conda:make" = "latest"
"aqua:starship/starship" = "latest"
"cargo:dysk" = { version = "latest", depends = ["core:rust", "conda:make"] }
"aqua:atuinsh/atuin" = "latest"
"asdf:mise-plugins/mise-tinytex" = { version = "latest", os = ["linux"] }

# Shell utils and "upgrades"
"aqua:BurntSushi/ripgrep" = "latest"
"aqua:junegunn/fzf" = "latest"
"aqua:sharkdp/fd" = "latest"
"aqua:eza-community/eza" = "latest"
"aqua:ajeetdsouza/zoxide" = "latest"
"aqua:tldr-pages/tlrc" = "latest"
"aqua:sharkdp/bat" = "latest"
"aqua:fastfetch-cli/fastfetch" = "latest"
###

### Linux-only tools ###
"aqua:pypa/pipx" = { version = "1.12", depends = ["core:python"], os = ["linux"] }
"ansible" = { version = "13", depends = ["aqua:pypa/pipx"], pipx_args = "--include-deps", uvx = false, os = ["linux"] }
# "aqua:aristocratos/btop" = { version = "latest", os = ["linux"] }
"conda:vim" = { version = "latest", os = ["linux"] }
###

### Windows-only tools ###
powershell = { version = "latest", os = ["windows"] }
###

{{- if has "development" .categories }}
### Development-only tools ###
# "core:go" = "1.26"
# "aqua:jesseduffield/lazygit" = "latest"
# "aqua:jesseduffield/lazydocker" = { version = "latest", os = ["linux"] }
# "aqua:anomalyco/opencode" = "latest"
"aqua:yarnpkg/berry" = "4.17"
"aqua:pnpm/pnpm" = "11.9"
###
{{- end}}

[env]
# Shared shell environment 
EDITOR = "nvim"
VISUAL = "nvim"
LESSHISTFILE = "-" # "-" disables the less history file
MANPAGER = 'nvim +"Man $*" +only'
FZF_DEFAULT_COMMAND = "fd --hidden --strip-cwd-prefix --exclude .git "
FZF_CTRL_T_COMMAND = "fd --hidden --strip-cwd-prefix --exclude .git "
FZF_ALT_C_COMMAND = "fd --type=d --hidden --strip-cwd-prefix --exclude .git"
FZF_DEFAULT_OPTS = '''
--height 50% --layout=default --border
      --color=fg:#908caa,bg:#191724,hl:#ebbcba
      --color=fg+:#e0def4,bg+:#26233a,hl+:#ebbcba
      --color=border:#403d52,header:#31748f,gutter:#191724
      --color=spinner:#f6c177,info:#9ccfd8
      --color=pointer:#c4a7e7,marker:#eb6f92,prompt:#908caa'''
FZF_CTRL_T_OPTS = "--preview 'bat --color=always -n --line-range :500 {}'"
FZF_ALT_C_OPTS = "--preview 'eza --icons=always --tree --color=always {} | head -200'"

[settings]
idiomatic_version_file_enable_tools = ["node"]
